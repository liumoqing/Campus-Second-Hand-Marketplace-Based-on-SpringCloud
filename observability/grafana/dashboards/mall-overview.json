{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "服务请求速率",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum by (application) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{application}}" }]
    },
    {
      "type": "timeseries",
      "title": "P95 响应时间",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "{{application}}" }]
    },
    {
      "type": "timeseries",
      "title": "5xx 错误率",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / clamp_min(sum by (application) (rate(http_server_requests_seconds_count[5m])), 0.001)", "legendFormat": "{{application}}" }]
    },
    {
      "type": "timeseries",
      "title": "JVM 堆内存使用",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "sum by (application, area) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{application}} · {{area}}" }]
    }
  ],
  "schemaVersion": 39,
  "tags": ["mall", "spring-cloud"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "晴川二手市场 · 微服务总览",
  "uid": "mall-overview",
  "version": 1
}
